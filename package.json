{
  "name": "webao",
  "version": "2.9.0",
  "description": "Web-based Attorney Online client",
  "main": "src/client.ts",
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview --port 8080",
    "server": "vite build && bun server.ts",
    "lint": "bunx --bun eslint src",
    "typecheck": "vue-tsc --noEmit",
    "probe": "bun scripts/probe-load.ts",
    "probe:3d": "bun scripts/probe-3d-textures.ts",
    "lint:fix": "bun run lint -- --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AttorneyOnline/webAO.git"
  },
  "author": "stonedDiscord",
  "bugs": {
    "url": "https://github.com/AttorneyOnline/webAO/issues"
  },
  "homepage": "https://github.com/AttorneyOnline/webAO#readme",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@happy-dom/global-registrator": "^20.0.11",
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.18.0",
    "puppeteer": "^25.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@babylonjs/core": "^9.27.1",
    "@fingerprintjs/fingerprintjs": "^3.4.2",
    "@vue/reactivity": "^3.5.45",
    "aolib-ts": "2.6.1",
    "babylon-mmd": "^1.3.0",
    "golden-layout": "^2.6.0",
    "libopus-wasm": "0.2.0",
    "vue": "^3.5.45"
  }
}
